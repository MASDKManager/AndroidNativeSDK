<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SampleWebviewApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SampleWebviewApp</item>
    </style>

    <style name="Theme.SampleWebviewApp" parent="Base.Theme.SampleWebviewApp" />

    <style name="webTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/SmoothWindowAnim</item>
    </style>

    <style name="SmoothWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_scale_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_scale_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_scale_out</item>
    </style>
</resources>
